# FRIDAY MODE: confident_explore
#
# THE FROZEN PARAMETERS OF THE BEST RUN SHE HAS EVER DONE — 2026-09-04 21:18,
# twenty minutes, and the configuration Harsh asked to keep permanently:
#
#   "This run was THE BEST ONE YET... Whenever I ask you to run her again she
#    should be able to run it like it did in the last run without any
#    hesitation, stutter and full confidence."
#
# Measured against the two preceding full-length runs:
#
#                          16:09     17:21     21:18
#     loop median         138.6 ms    48.7     34.3 ms
#     over 100 ms budget      62%      30%        13%
#     ToF reflex firing       85%      75%        44%
#     ground driven        20.9 m     41.7     59.2 m
#     time driving             8%      16%        26%
#     time spinning in place  n/a      35%        21%
#     map               discarded    kept    299.6 m^2
#
# THIS FILE IS THE SINGLE SOURCE OF TRUTH FOR THOSE FLAGS. Nothing else should
# hard-code them: modes/explore.sh reads this, and the systemd unit runs that,
# so there is exactly one place where "how she runs" is written down.
#
# The code half of the configuration is the git tag `run-20260904-2118-best`.
# Flags alone will not reproduce the run if rl/ has moved on; restore both:
#
#     git checkout run-20260904-2118-best -- rl/
#
# ---------------------------------------------------------------------------

# Wheels live. --i-am-watching is the deliberate speed bump on autonomous
# driving and it is passed here because a MODE is, by definition, the case
# where a human has already decided.
MODE_MOTOR="friday"

# 0.6 -- the navigator may command up to 60% of v_max on an arc it has
# SIMULATED CLEAR against the live scan. Without this she is only ever as
# decisive as the policy, and this policy is timid (measured mean v_raw
# +0.206 m/s; it asks for 0.026 in an open room). The 21:18 run used 0.6 and
# it is the difference between exploring and creeping.
MODE_NAV_AUTHORITY="0.6"

# Twenty minutes. Long enough for the map to grow and for the frontier planner
# to finish targets it starts; short enough to watch.
MODE_DURATION="1200"

# She narrates. For a demo this is most of the effect, and the narration runs
# on its own thread and cannot delay the control loop.
MODE_VOICE="1"
