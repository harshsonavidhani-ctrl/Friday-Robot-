# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtualenv
venv/
.venv/

# Secrets — never commit keys
.env
secrets.py

# Runtime output
logs/*.log
logs/*.jsonl

# Models are large; fetch them with scripts/, don't commit
assets/models/
*.onnx
*.gguf

# OS
.DS_Store

# runtime state (written by face_control.py)
state/*.txt
state/.emotion.*
certs/
state/calibration.json
__pycache__/

# Arduino toolchain — 429 MB of downloaded compiler and cores. Vendored INSIDE
# the project (see tools/arduino-env.sh) so flashing needs no system package,
# but it is a build tool, not source, and must not be committed. The small
# env script and the sketch itself are.
tools/arduino/
tools/arduino-cli
tools/arduino-cli.tar.gz

# Runtime state, not source. The decision log is the record of what Friday DID
# on THIS robot -- it grows forever and means nothing in a fresh clone.
state/*.sqlite3
state/*.sqlite3-shm
state/*.sqlite3-wal
state/captures/

# arduino-cli's downloaded core and toolchain (~200 MB). The BINARY and the
# env script are tracked; what they fetch is not.
tools/arduino/
tools/arduino-cli
tools/arduino-cli.tar.gz
